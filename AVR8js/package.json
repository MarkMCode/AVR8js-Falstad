{
  "name": "avr8js",
  "version": "0.10.1",
  "main": "dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "author": "Uri Shaked <uri@urishaked.com>",
  "repository": "https://github.com/wokwi/avr8js",
  "license": "MIT",
  "scripts": {
    "build": "rimraf dist && tsc --sourceMap false && tsc -m commonjs --outDir dist/cjs --sourceMap false",
    "build:demo": "parcel build demo/src/index.html -d demo/dist --public-url ./",
    "prepare": "npm run build",
    "start": "parcel demo/src/index.html -d demo/build",
    "lint": "eslint src/**/*.ts demo/**/*.ts",
    "test": "npm run lint && jest",
    "test:watch": "jest --watch",
    "benchmark:prepare": "ts-node --project tsconfig.benchmark.json benchmark/convert-instructions.ts",
    "benchmark": "ts-node --project tsconfig.benchmark.json benchmark/index.ts"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.1",
    "@types/prettier": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@wokwi/elements": "^1.9.1",
    "acorn": "^8.15.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.2.2",
    "eslint-plugin-json": "^4.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "parcel-bundler": "^1.12.5",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ]
  },
  "engines": {
    "node": ">= 8.0.0",
    "npm": ">= 5.0.0"
  },
  "dependencies": {},
  "alias": {
    "avr8js": "./src"
  },
  "browserslist": [
    "last 1 Chrome versions"
  ]
}
